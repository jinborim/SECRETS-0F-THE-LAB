      propertyPath: m_Name
      value: paper (1)
      objectReference: {fileID: 0}
    - target: {fileID: 5202058928936592683, guid: 7fab3f1e62014f94ebe5191c44f294f0,
        type: 3}
      propertyPath: Read_Text
      value: "\uC5F0\uAD6C\uC6D0\uC758 \uC77C\uAE30\n\n\uC9C0\uAE08 \uC5EC\uAE30\uB294
        \uB9E4\uC6B0 \uC704\uD5D8\uD558\uB2E4,\n\uC0AC\uB78C\uC774 \uC544\uB2CC \uAD34\uBB3C\uC774
        \uC874\uC7AC\uD55C\uB2E4.\n\uD654\uC7A5\uC2E4\uC774 \uADF8\uB098\uB9C8 \uC548\uC804\uD55C
        \uACF3\uC774\uB784\uAE4C...\n\uC778\uAC04\uB4E4\uC758 \uC695\uC2EC \uB05D\uC5D0
        \uC774\uB7F0\uC77C\uC774 \uC77C\uC5B4\uB098\uB294 \uAC83 \uAC19\uB2E4.\n\uC5EC\uAE30\uC11C 
        \uBE60\uC838\uB098\uAC04 \uC0AC\uB78C\uC740 \uB2E8 \uD55C\uBA85\uB3C4 \uC5C6\uC5C8\uB2E4.\n\uB098\uB3C4
        \uC5B8\uC81C \uC8FD\uC744\uC9C0\uB294 \uBAA8\uB974\uC9C0\uB9CC \uB204\uAD70\uAC00\uAC00
        \uC774 \uC77C\uAE30\uC7A5\uC744 \uBCF8\uB2E4\uBA74 \uAF2D \uC0B4\uC544\uB0A8\uB3C4\uB85D
        \uD574.\n\uC5EC\uAE30\uB97C \uB098\uAC00\uAE30 \uC704\uD574\uC120 \uC554\uD638\uB97C
        \uC54C\uC544\uC57C\uD558\uB294\uB370 \uC774\uAC8C \uC554\uD638\uC57C.\n\u2605\u2605\u2606\u2605\u2606\u2606\u2605\u2606\u2606\n\uCC38\uACE0\uB85C
        0\uC744 \uD3EC\uD568 \uC2DC\uD0A4\uC9C0 \uC54A\uC558\uC73C\uB2C8 0\uC744
        \uC0DD\uAC01\uD55C\uB2E4\uBA74 \uD480\uC218 \uC5C6\uC744\uAC70\uC57C."
      objectReference: {fileID: 0}
